# Copy to .env (git-ignored) and fill in. Real environment variables take precedence.
# D-Shift also reads ~/.config/dshift/.env when launched outside the repo.

# Required for chat, screen context, memory, drawings, and 3D models.
# Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: where memory and chat history live.
# Default: ~/Library/Application Support/DShift
# DSHIFT_DATA_DIR=~/Documents/dshift

# Optional local speech server. See docs/voice.md for setup; no API key is sent to it.
# DSHIFT_TTS_URL=http://127.0.0.1:8870/v1/audio/speech
# DSHIFT_TTS_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-8bit
# DSHIFT_TTS_VOICE=Aiden
# DSHIFT_STT_URL=http://127.0.0.1:8870/v1/audio/transcriptions
# DSHIFT_STT_MODEL=mlx-community/whisper-large-v3-turbo-asr-fp16
